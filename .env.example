APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

HILOGATE_BASE_URL=https://app.hilogate.com/api
HILOGATE_MERCHANT_ID=
HILOGATE_SECRET_KEY=
HILOGATE_ENVIRONMENT=sandbox
HILOGATE_TIMEOUT_SECONDS=20
HILOGATE_RESOLVE_IP=
HILOGATE_PULL_MODE=qris
HILOGATE_ONBOARDING_EMAIL=
HILOGATE_ONBOARDING_PASSWORD=
HILOGATE_TRANSACTION_CALLBACK_URL=${APP_URL}/api/callbacks/hilogate/transaction
HILOGATE_WITHDRAWAL_CALLBACK_URL=${APP_URL}/api/callbacks/hilogate/withdrawal
TELEGRAM_BOT_SHEET_ID=
TELEGRAM_BOT_SHEET_RANGE=A:X
TELEGRAM_BOT_SHEET_CACHE_TTL=45
TELEGRAM_BOT_REMINDER_THRESHOLD_MINUTES=15
# Bot token for the n8n ticketing bot ("Bot Tele") - needed only to delete ticket card
# messages in Telegram when a CS Pusat user rejects a ticket. Different bot from
# TELEGRAM_BOT_TOKEN (that one is the attendance/absen bot).
TELEGRAM_TICKET_BOT_TOKEN=
TELEGRAM_TICKET_CS_GROUP_CHAT_ID=-1004445566939
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
# PEM private key from the service account JSON key file; keep it on one line with literal \n for newlines
GOOGLE_SHEETS_SERVICE_ACCOUNT_PRIVATE_KEY=

PAYGRID_DEMO_PASSWORD=change-me
PAYGRID_TOPUP_MINIMUM_AMOUNT=1000
PAYGRID_TOPUP_MAXIMUM_AMOUNT=2000000
PAYGRID_TOPUP_EXPIRES_MINUTES=30
PAYGRID_TOPUP_TICKET_GRACE_MINUTES=10

# WhatsApp notifier (WAHA), see app/Services/WhatsApp/WhatsAppNotifier.php - used by the
# WA ops-assistant bridge. Leave blank to run in log-only mode (no real messages sent).
PAYGRID_WHATSAPP_API_URL=
PAYGRID_WHATSAPP_API_KEY=

# Telegram absen bot - called by the n8n workflow, see app/Http/Controllers/Api/TelegramBotController.php.
TELEGRAM_BOT_CALLBACK_TOKEN=
# Real Telegram bot token from @BotFather - used server-side to call getChatMemberCount
# for the "Member Grup Telegram" KPI card. Leave blank to just hide that card's number.
TELEGRAM_BOT_TOKEN=

# CS Pusat broadcast feature, see app/Services/Telegram/TelegramBroadcaster.php. Groups
# format: "Name:chat_id,Name:chat_id" - the bot must already be a member of each group.
TELEGRAM_BROADCAST_BOT_TOKEN=
TELEGRAM_BROADCAST_GROUPS=

# Co PayGrid / Data PayGrid WhatsApp bot status service (tools/co-paygrid), see
# SuperadminController::integrationStatus() - powers the "Integrasi" page's QR linking.
# CO_PAYGRID_STATUS_URL defaults to http://127.0.0.1:8787 if left blank.
CO_PAYGRID_STATUS_URL=
CO_PAYGRID_STATUS_TOKEN=
