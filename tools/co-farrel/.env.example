# Anthropic API key for the agent (or log in once with `ant auth login` as the service user).
ANTHROPIC_API_KEY=

# Where the agent listens for WAHA webhooks. Use the Docker bridge IP as HOST if WAHA runs in a container.
HOST=127.0.0.1
PORT=8787

# The live PayGrid folder the read-only tools look at.
PAYGRID_DIR=/var/www/paygrid
PHP_BIN=php

# WAHA: same server PayGrid already uses. Use a separate WhatsApp session/number for the bot if possible.
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=default
# Must equal the HMAC key set on the WAHA webhook that points to http://HOST:PORT/waha
WAHA_WEBHOOK_HMAC_KEY=

# The one WhatsApp group the agent answers in (…@g.us), and the bot's own number (digits only).
WA_GROUP_ID=
BOT_NUMBER=
# Optional: the bot's WhatsApp "lid" id, if mentions arrive as @<lid> instead of @<number>.
BOT_LID=

# Who may talk to the agent: phone:Name:role, comma separated. Role is pemilik, atasan or anggota.
# Numbers not listed are ignored.
MEMBERS=6281100000000:Farrel:pemilik,6281200000000:Koh:atasan

# Optional
AGENT_MODEL=claude-opus-5-5
MAX_BUDGET_USD=1
STATE_FILE=./state.json
